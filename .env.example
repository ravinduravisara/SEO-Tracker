APP_ENV=development
PORT=8000
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=20
DEFAULT_MAX_PAGES=25000
CRAWL_WORKERS=8
CRAWL_TIMEOUT=20
MAX_BODY_BYTES=5000000
LINK_CHECK_TIMEOUT=5
RESOURCE_CHECK_TIMEOUT=5
PREFLIGHT_TIMEOUT=8
# --- AI Intelligence & Gemma 4 Configuration ---
AI_PROVIDER=auto
AI_MODEL_ID=gemma4:31b
AI_API_KEY=
AI_RAG_ENABLED=true
AI_VALIDATION_ENABLED=true
AI_FALLBACK_ENABLED=true
AI_KNOWLEDGE_REFRESH_ENABLED=false
AI_API_TIMEOUT=30
AI_MAX_RETRIES=3
AI_MAX_INPUT_TOKENS=8192
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_REQUESTS_PER_AUDIT=5
AI_KNOWLEDGE_VERSION=1.0.0
# Legacy AI Compatibility
OLLAMA_URL=
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=20
CRAWLER_USER_AGENT=eSupportSEO/10.4 (+respectful technical SEO audit)
DATABASE_URL=sqlite:///./seo_platform.db
PUBLIC_REPORT_BASE_URL=https://esupport.live
WHATSAPP_NUMBER=94710690715
SUPPORT_EMAIL=prasad@esupport.live

# --- Real SEO data integrations (see docs/REAL_DATA_SETUP.md) ---
# Google PageSpeed Insights API key (free). Gives real Core Web Vitals (CrUX) + Lighthouse.
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT=90
# Google Search Console: service-account JSON key file path (or paste JSON in GSC_SERVICE_ACCOUNT_JSON)
GSC_SERVICE_ACCOUNT_FILE=
GSC_SERVICE_ACCOUNT_JSON=
# DataForSEO (paid): keyword volume, keyword difficulty, rankings, backlinks
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# 2144 = Sri Lanka, 2840 = United States, 2826 = United Kingdom, 2036 = Australia
DATAFORSEO_LOCATION_CODE=2144
DATAFORSEO_LANGUAGE_CODE=en
# Reuse identical API results for this many hours (saves quota and money)
INTEGRATION_CACHE_HOURS=24
# Open PageRank (FREE key from https://www.domcop.com/openpagerank/) - powers the Off-Page / Backlinks score
OPENPAGERANK_API_KEY=
# Ollama writes plain-language category explanations (free, local). Never changes scores.
OLLAMA_INSIGHT_TIMEOUT=90
PUBLIC_SCAN_AI=1

